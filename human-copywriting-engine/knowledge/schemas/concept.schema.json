{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hce.local/schemas/concept.schema.json",
  "title": "HCE Concept Record",
  "type": "object",
  "required": [
    "concept_id",
    "concept_name",
    "category",
    "explanation",
    "underlying_psychology",
    "application_conditions",
    "implementation",
    "examples",
    "counterexamples",
    "limitations",
    "related_concepts",
    "source_id",
    "source_timestamp",
    "extraction_confidence",
    "validation_status",
    "statement_type"
  ],
  "properties": {
    "concept_id": { "type": "string", "minLength": 3 },
    "concept_name": { "type": "string", "minLength": 3 },
    "category": {
      "type": "string",
      "enum": [
        "human_language",
        "buyer_psychology",
        "persuasive_writing",
        "storytelling",
        "audience_adaptation",
        "creative_evaluation"
      ]
    },
    "explanation": { "type": "string", "minLength": 10 },
    "underlying_psychology": { "type": "string", "minLength": 5 },
    "application_conditions": { "type": "array", "items": { "type": "string" } },
    "implementation": { "type": "array", "items": { "type": "string" } },
    "examples": { "type": "array", "items": { "type": "string" } },
    "counterexamples": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "related_concepts": { "type": "array", "items": { "type": "string" } },
    "source_id": { "type": "string", "minLength": 1 },
    "source_timestamp": { "type": "string", "minLength": 1 },
    "extraction_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "validation_status": {
      "type": "string",
      "enum": ["pending", "validated", "contested", "rejected"]
    },
    "statement_type": {
      "type": "string",
      "enum": [
        "direct_instructor_statement",
        "inferred_explanation",
        "verified_fact",
        "subjective_opinion",
        "practical_demonstration"
      ]
    },
    "competing_viewpoints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "provenance_refs": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
