{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hce.local/schemas/extraction_result.schema.json",
  "title": "HCE Extraction Result",
  "type": "object",
  "required": ["task_id", "source_id", "adapter_name", "concepts"],
  "properties": {
    "task_id": { "type": "string" },
    "source_id": { "type": "string" },
    "adapter_name": { "type": "string" },
    "concepts": {
      "type": "array",
      "items": { "$ref": "concept.schema.json" }
    },
    "notes": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
